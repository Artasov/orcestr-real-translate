# Runtime endpoint overrides are read by Rust and are never embedded into the web bundle.
# No overrides are required: debug and release builds both use these production endpoints.
ORCESTR_AUTHORIZE_URL=https://orcestr.com/oauth/authorize
ORCESTR_API_BASE_URL=https://orcestr.com/api/v1

# Explicit local-backend opt-in for a debug build only:
# ORCESTR_AUTHORIZE_URL=http://localhost:8934/oauth/authorize
# ORCESTR_API_BASE_URL=http://localhost:3934/api/v1
